      "body-sm": {
        "$type": "dimension",
        "$value": "{font-size.14}",
        "$extensions": {
          "com.figma": {
            "name": "font/size/body-sm"
          }
        }
      },
      "caption": {
        "$type": "dimension",
        "$value": "{font-size.12}",
        "$extensions": {
          "com.figma": {
            "name": "font/size/caption"
          }
        }
      },
      "label": {
        "$type": "dimension",
        "$value": "{font-size.12}",
        "$extensions": {
          "com.figma": {
            "name": "font/size/label"
          }
        }
      },
      "button-sm": {
        "$type": "dimension",
        "$value": "{font-size.12}",
        "$extensions": {
          "com.figma": {
            "name": "font/size/button-sm"
          }
        }
