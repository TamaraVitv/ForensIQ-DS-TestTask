    "line-height": {
      "h3": {
        "$type": "dimension",
        "$value": "{line-height.32}",
        "$extensions": {
          "com.figma": {
            "name": "font/line-height/h3"
          }
        }
      },
      "h4": {
        "$type": "dimension",
        "$value": "{line-height.25}",
        "$extensions": {
          "com.figma": {
            "name": "font/line-height/h4"
          }
        }
      },
      "body-lg": {
        "$type": "dimension",
        "$value": "{line-height.30}",
        "$extensions": {
          "com.figma": {
            "name": "font/line-height/body-lg"
          }
        }
      },
      "body-md": {
        "$type": "dimension",
        "$value": "{line-height.28}",
        "$extensions": {
          "com.figma": {
            "name": "font/line-height/body-md"
          }
        }
      },
      "body-sm": {
        "$type": "dimension",
        "$value": "{line-height.20}",
        "$extensions": {
          "com.figma": {
            "name": "font/line-height/body-sm"
          }
        }
      },
      "caption": {
        "$type": "dimension",
        "$value": "{line-height.18}",
        "$extensions": {
          "com.figma": {
            "name": "font/line-height/caption"
          }
        }
      }
    },
    "letter-spacing": {
      "normal": {
        "$type": "dimension",
        "$value": "{letter-spacing.0}",
        "$extensions": {
          "com.figma": {
            "name": "font/letter-spacing/normal"
          }
        }
      },
      "wide": {
        "$type": "dimension",
        "$value": "{letter-spacing.1-1}",
        "$extensions": {
          "com.figma": {
            "name": "font/letter-spacing/wide"
          }
        }
      }
    }
  }
}
