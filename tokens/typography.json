{
  "$description": "Type families, weights, sizes, line heights and letter spacing.",
  "font": {
    "family": {
      "sans": {
        "$type": "dimension",
        "$value": "{font-family.inter}",
        "$extensions": {
          "com.figma": {
            "name": "font/family/sans"
          }
        }
      },
      "mono": {
        "$type": "dimension",
        "$value": "{font-family.ibm-plex-mono}",
        "$extensions": {
          "com.figma": {
            "name": "font/family/mono"
          }
        }
      }
    },
    "weight": {
      "regular": {
        "$type": "dimension",
        "$value": "{font-weight.regular}",
        "$extensions": {
          "com.figma": {
            "name": "font/weight/regular"
          }
        }
      },
      "medium": {
        "$type": "dimension",
        "$value": "{font-weight.medium}",
        "$extensions": {
          "com.figma": {
            "name": "font/weight/medium"
          }
        }
      },
      "semibold": {
        "$type": "dimension",
        "$value": "{font-weight.semibold}",
        "$extensions": {
          "com.figma": {
            "name": "font/weight/semibold"
          }
        }
      }
    },
    "size": {
      "h1": {
        "$type": "dimension",
        "$value": "{font-size.64}",
        "$extensions": {
          "com.figma": {
            "name": "font/size/h1"
          }
        }
      },
      "h2": {
        "$type": "dimension",
        "$value": "{font-size.40}",
        "$extensions": {
          "com.figma": {
            "name": "font/size/h2"
          }
        }
      },
      "h3": {
        "$type": "dimension",
        "$value": "{font-size.24}",
        "$extensions": {
          "com.figma": {
            "name": "font/size/h3"
          }
        }
      },
      "h4": {
        "$type": "dimension",
        "$value": "{font-size.18}",
        "$extensions": {
          "com.figma": {
            "name": "font/size/h4"
          }
        }
      },
      "body-lg": {
        "$type": "dimension",
        "$value": "{font-size.18}",
        "$extensions": {
          "com.figma": {
